# SSR (server-side fetch) — use internal URL on VPS
CMS_API_URL=http://127.0.0.1:3000/api
# Browser fetch — use the public API host (not www unless /api is proxied there)
VITE_CMS_API_URL=https://web.nfctec.com/api

# Optional — Supabase (C-end auth deferred)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
